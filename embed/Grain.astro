---
// Embeds the deployed Grain sandbox in an isolated iframe.
interface Props {
  src: string;          // URL of the deployed page, e.g. https://<user>.github.io/grain/?theme=dark
  height?: string;      // any CSS length; defaults to a comfortable viewport-relative height
  title?: string;
}
const { src, height = "min(80vh, 720px)", title = "Grain, a falling-sand sandbox" } = Astro.props;
---
<div class="grain-embed" style={`--grain-h:${height}`}>
  <iframe src={src} title={title} loading="lazy" allow="fullscreen"></iframe>
</div>

<style>
  .grain-embed {
    width: 100%;
    height: var(--grain-h);
    min-height: 420px;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(127, 127, 127, 0.25);
  }
  .grain-embed iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
